//@version=5
indicator("CryptoScanner Heatmap — OI+Volume Zones", overlay=true, shorttitle="Heatmap Zones")

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS — Customize with your price levels
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group_prices = "Price Levels (±% from current)"
price_offset = input.float(1.0, "Price Offset (%)", minval=0.1, maxval=5.0, step=0.1, group=group_prices)

group_display = "Display Settings"
show_blue_line = input.bool(true, "Show Blue Zone (Low Intensity)", group=group_display)
show_orange_line = input.bool(true, "Show Orange Zone (Medium Intensity)", group=group_display)
show_red_line = input.bool(true, "Show Red Zone (High Intensity)", group=group_display)
show_labels = input.bool(true, "Show Price Labels", group=group_display)
line_width = input.int(2, "Line Width", minval=1, maxval=5, group=group_display)
line_style = input.string("dashed", "Line Style", options=["solid", "dashed", "dotted"], group=group_display)

group_colors = "Zone Colors"
blue_color = input.color(color.new(color.blue, 30), "Blue Zone Color", group=group_colors)
orange_color = input.color(color.new(color.orange, 30), "Orange Zone Color", group=group_colors)
red_color = input.color(color.new(color.red, 30), "Red Zone Color", group=group_colors)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CALCULATIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

current_price = close

// Calculate 7 price levels: -3%, -2%, -1%, 0%, +1%, +2%, +3%
level_minus3 = current_price * (1 - (3 * price_offset / 100))  // -3%  (Blue - Low)
level_minus2 = current_price * (1 - (2 * price_offset / 100))  // -2%  (Blue)
level_minus1 = current_price * (1 - (price_offset / 100))      // -1%  (Orange - Medium)
level_0 = current_price                                          // 0%   (Current Price)
level_plus1 = current_price * (1 + (price_offset / 100))       // +1%  (Orange - Medium)
level_plus2 = current_price * (1 + (2 * price_offset / 100))   // +2%  (Orange)
level_plus3 = current_price * (1 + (3 * price_offset / 100))   // +3%  (Red - High)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW BLUE ZONE (Low Intensity: -3% to -1%)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if show_blue_line
    // Support Line 1 (-3%)
    line.new(bar_index, level_minus3, bar_index + 500, level_minus3,
             extend=extend.right, color=blue_color, width=line_width,
             style=line_style == "solid" ? line.style_solid : line_style == "dashed" ? line.style_dashed : line.style_dotted)
    if show_labels
        label.new(bar_index, level_minus3, str.format(" ${0}", math.round(level_minus3, 2)),
                 textcolor=color.blue, color=color.new(color.blue, 80), style=label.style_label_right)

    // Support Line 2 (-2%)
    line.new(bar_index, level_minus2, bar_index + 500, level_minus2,
             extend=extend.right, color=color.new(color.blue, 40), width=line_width,
             style=line_style == "solid" ? line.style_solid : line_style == "dashed" ? line.style_dashed : line.style_dotted)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW ORANGE ZONE (Medium Intensity: -1% to +1%)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if show_orange_line
    // Resistance/Support Line 1 (-1%)
    line.new(bar_index, level_minus1, bar_index + 500, level_minus1,
             extend=extend.right, color=orange_color, width=line_width,
             style=line_style == "solid" ? line.style_solid : line_style == "dashed" ? line.style_dashed : line.style_dotted)
    if show_labels
        label.new(bar_index, level_minus1, str.format(" ${0}", math.round(level_minus1, 2)),
                 textcolor=color.orange, color=color.new(color.orange, 80), style=label.style_label_right)

    // Current Price Line (0%) - Bold
    line.new(bar_index, level_0, bar_index + 500, level_0,
             extend=extend.right, color=color.orange, width=line_width + 1,
             style=line_style == "solid" ? line.style_solid : line_style == "dashed" ? line.style_dashed : line.style_dotted)
    if show_labels
        label.new(bar_index, level_0, str.format(" CURRENT ${0}", math.round(level_0, 2)),
                 textcolor=color.orange, color=color.new(color.orange, 60), style=label.style_label_right, size=size.small)

    // Resistance Line 2 (+1%)
    line.new(bar_index, level_plus1, bar_index + 500, level_plus1,
             extend=extend.right, color=orange_color, width=line_width,
             style=line_style == "solid" ? line.style_solid : line_style == "dashed" ? line.style_dashed : line.style_dotted)
    if show_labels
        label.new(bar_index, level_plus1, str.format(" ${0}", math.round(level_plus1, 2)),
                 textcolor=color.orange, color=color.new(color.orange, 80), style=label.style_label_right)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW RED ZONE (High Intensity: +1% to +3%)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if show_red_line
    // Resistance Line 1 (+2%)
    line.new(bar_index, level_plus2, bar_index + 500, level_plus2,
             extend=extend.right, color=color.new(color.red, 40), width=line_width,
             style=line_style == "solid" ? line.style_solid : line_style == "dashed" ? line.style_dashed : line.style_dotted)

    // Resistance Line 2 (+3%)
    line.new(bar_index, level_plus3, bar_index + 500, level_plus3,
             extend=extend.right, color=red_color, width=line_width,
             style=line_style == "solid" ? line.style_solid : line_style == "dashed" ? line.style_dashed : line.style_dotted)
    if show_labels
        label.new(bar_index, level_plus3, str.format(" ${0}", math.round(level_plus3, 2)),
                 textcolor=color.red, color=color.new(color.red, 80), style=label.style_label_right)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INFO BOX
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Display heatmap intensity info
box.new(bar_index - 50, level_plus3 * 1.02, bar_index, level_plus3 * 1.04,
        bgcolor=color.new(color.gray, 80), border_color=color.orange, border_width=2)

table.cell(table.new(position.top_left, 3, 1, bgcolor=color.new(color.black, 50), border_color=color.orange)[1, 1],
           text="🔥 CryptoScanner Heatmap Zones Active | Offset: " + str.tostring(price_offset) + "%",
           text_color=color.orange, text_size=size.small)
